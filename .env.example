# ── API Security ────────────────────────────────────────────────
API_SECRET_KEY=your_strong_random_secret_here
RATE_LIMIT_PER_MINUTE=10

# ── LLM via Groq ────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── Web Search ──────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── LangSmith (optional; disabled by default for local runs) ───
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=BoardOfDirectors
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── Notion (optional; disabled by default) ─────────────────────
NOTION_ENABLED=false
NOTION_API_KEY=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# ── Model overrides (optional) ───────────────────────────────────
# Every agent inherits GROQ_MODEL unless overridden independently.
# See https://console.groq.com/docs/models for currently available IDs.
#
# CEO_MODEL=openai/gpt-oss-120b
# RESEARCHER_MODEL=openai/gpt-oss-120b
# CFO_MODEL=openai/gpt-oss-120b
# CTO_MODEL=openai/gpt-oss-120b
# CMO_MODEL=openai/gpt-oss-120b
# SALES_MODEL=openai/gpt-oss-120b
# COO_MODEL=openai/gpt-oss-120b
# PM_MODEL=openai/gpt-oss-120b
